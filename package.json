{
	"name": "calendrier",
	"version": "1.0.6",
	"description": "Une application calendrier minimaliste pour bureau",
	"author": "",
	"homepage": "https://github.com/nanaelie/calendar#readme",
	"main": "electron/main.js",
	"scripts": {
		"dev": "electron .",
		"css": "npx tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/output.css --watch",
		"build": "electron-builder"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nanaelie/calendar.git"
	},
	"keywords": [],
	"license": "Apache-2.0",
	"type": "module",
	"bugs": {
		"url": "https://github.com/nanaelie/calendar/issues"
	},
	"dependencies": {
		"bootstrap-icons": "^1.13.1"
	},
	"devDependencies": {	
		"electron-builder": "^26.15.3",
		"electron": "^43.1.1",
		"tailwindcss": "^3.4.19"
	},
	"build": {
		"appId": "com.nae.calendar",
		"productName": "Calendrier",
		"directories": {
			"buildResources": "src/assets/images",
			"output": "dist_build"
		},
		"files": [
			"dist/**/*",
			"src/**/*",
			"package.json"
		],
		"win": {
			"icon": "src/assets/images/icon.ico",
			"target": [
				"nsis",
				"exe"
			]
		},
		"mac": {
			"icon": "src/assets/images/icon.icns",
			"target": [
				"dmg",
				"zip"
			]
		},
		"linux": {
			"icon": "src/assets/images",
			"category": "Office",
			"maintainer": "Nana Elie nae.devp@gmail.com",
			"target": [
				"AppImage",
				"deb",
				"snap"
			]
		}
	}
}
